# Copy to .env.local and fill in
MONGODB_URI=mongodb://127.0.0.1:27017/cakeitis
ADMIN_PASSWORD=choose-a-strong-password
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Telegram alerts for new orders/bookings (optional). Create a bot with @BotFather,
# send it a message, then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public site address, used for the admin link in alerts (e.g. https://cakeitis.com)
SITE_URL=http://localhost:3000

# Contact links shown in the footer + floating WhatsApp button (leave empty to hide)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
